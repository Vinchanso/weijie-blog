---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPostsByTag, decodeTag, encodeTag, getAllTags } from '../../../i18n/tags';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const tags = await getAllTags('zh');
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = await getPostsByTag(tag, 'zh');
---

<BaseLayout lang="zh" title={`#${tag}`}>
  <section>
    <div style="margin-bottom: 32px;">
      <a href="/zh/tags/" style="font-size: var(--font-size-small); color: var(--color-text-muted); border-bottom: none;">
        &larr; {t('zh', 'backToTags')}
      </a>
      <h1 style="font-size: var(--font-size-h1); margin-top: 12px;">
        #{tag}
        <span style="font-size: var(--font-size-small); color: var(--color-text-muted); font-weight: normal;">
          {posts.length} {t('zh', 'postsWithTag')}
        </span>
      </h1>
    </div>
    <ul class="post-list">
      {posts.map((post) => (
        <PostCard
          lang="zh"
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.id}
          rawBody={post.body}
        />
      ))}
    </ul>
  </section>
</BaseLayout>
