---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, encodeTag } from '../../../i18n/tags';
import { t } from '../../../i18n';

const tags = await getAllTags('zh');
---

<BaseLayout lang="zh" title={t('zh', 'allTags')}>
  <section>
    <h1 style="font-size: var(--font-size-h1); margin-bottom: 32px;">{t('zh', 'allTags')}</h1>
    {tags.length > 0 ? (
      <div class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <a href={`/zh/tags/${encodeTag(tag)}`} class="tag-cloud__item">
            <span class="tag-cloud__name">#{tag}</span>
            <span class="tag-cloud__count">{count}</span>
          </a>
        ))}
      </div>
    ) : (
      <p style="color: var(--color-text-muted);">{t('zh', 'noPosts')}</p>
    )}
  </section>
</BaseLayout>
