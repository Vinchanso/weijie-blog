---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('enPosts', ({ data }) => !data.draft);
  const zhPosts = await getCollection('zhPosts', ({ data }) => !data.draft);
  const zhSlugs = new Set(zhPosts.map((p) => p.id));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, alternateExists: zhSlugs.has(post.id) },
  }));
}

const { post, alternateExists } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = (await getCollection('enPosts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<PostLayout
  lang="en"
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  heroImage={post.data.heroImage}
  rawBody={post.body}
  headings={headings}
  alternateExists={alternateExists}
>
  <Content />

  <nav slot="nav" class="article-nav">
    {prevPost && (
      <a href={`/en/posts/${prevPost.id}`}>&larr; {prevPost.data.title}</a>
    )}
    {nextPost && (
      <a href={`/en/posts/${nextPost.id}`}>{nextPost.data.title} &rarr;</a>
    )}
  </nav>
</PostLayout>
