---
import type { Lang } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Giscus config — these values come from https://giscus.app after setup
const repo = 'Vinchanso/weijie-blog';
const repoId = 'R_kgDOTw0Mww'; // verified via GitHub GraphQL API
const category = 'Announcements';
const categoryId = 'DIC_kwDOTw0Mw84DC2R0'; // verified
const isZh = lang === 'zh';
---

<section class="comments" aria-label={isZh ? '评论' : 'Comments'}>
  <h2 class="comments__title">{isZh ? '评论' : 'Comments'}</h2>
  <div class="comments__container">
    <div class="giscus"></div>
  </div>
</section>

<script>
  function loadGiscus() {
    const container = document.querySelector('.giscus');
    if (!container || container.children.length > 0) return;

    const lang = document.documentElement.lang === 'zh' ? 'zh-CN' : 'en';
    const theme = document.documentElement.dataset.theme === 'dark'
      ? '/themes/giscus-dark.css'
      : '/themes/giscus-light.css';

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', 'Vinchanso/weijie-blog');
    script.setAttribute('data-repo-id', 'R_kgDOTw0Mww');
    script.setAttribute('data-category', 'Announcements');
    script.setAttribute('data-category-id', 'DIC_kwDOTw0Mw84DC2R0');
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'top');
    script.setAttribute('data-theme', theme);
    script.setAttribute('data-lang', lang);
    script.setAttribute('data-loading', 'lazy');
    script.crossOrigin = 'anonymous';
    script.async = true;
    container.appendChild(script);
  }

  // Lazy load: only when comments section scrolls into view
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        loadGiscus();
        observer.disconnect();
      }
    },
    { rootMargin: '200px' }
  );

  const commentsSection = document.querySelector('.comments');
  if (commentsSection) {
    observer.observe(commentsSection);
  }

  // Sync theme changes to Giscus
  function updateGiscusTheme() {
    const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (iframe) {
      const theme = document.documentElement.dataset.theme === 'dark'
        ? window.location.origin + '/themes/giscus-dark.css'
        : window.location.origin + '/themes/giscus-light.css';
      iframe.contentWindow?.postMessage(
        { giscus: { setConfig: { theme } } },
        'https://giscus.app'
      );
    }
  }

  // Watch for theme toggle (Ctrl+`)
  const themeObserver = new MutationObserver(updateGiscusTheme);
  const html = document.documentElement;
  themeObserver.observe(html, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
.comments {
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid var(--color-border);
}

.comments__title {
  font-size: var(--font-size-small);
  font-weight: 600;
  color: var(--color-text-muted);
  margin-bottom: 24px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-family: var(--font-serif);
}

.comments__container {
  min-height: 100px;
}

/* Override Giscus iframe container width to match article width */
.comments__container :global(.giscus-frame) {
  width: 100%;
}
</style>
