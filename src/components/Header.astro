---
import { t } from '../i18n';
import { getAlternateLangPath } from '../i18n';
import Search from './Search.astro';
import type { Lang } from '../consts';

interface Props {
  lang: Lang;
  currentPath: string;
  alternateExists?: boolean;
}

const { lang, currentPath, alternateExists = true } = Astro.props;
const title = t(lang, 'siteTitle');
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';

// 如果当前文章没有另一种语言版本，切换按钮指向对应语言首页
const altLangPath = alternateExists
  ? getAlternateLangPath(currentPath, lang)
  : `/${otherLang}/`;
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__title">
      <a href={`/${lang}/`}>{title}</a>
    </div>
    <nav class="site-header__nav">
      <a href={`/${lang}/`}>{t(lang, 'home')}</a>
      <a href={`/${lang}/tags/`}>{t(lang, 'tags')}</a>
      <a href={`/${lang}/about`}>{t(lang, 'about')}</a>
      <Search lang={lang} />
      <a href="/rss.xml" aria-label="RSS">RSS</a>
      <a
        class="site-header__lang-switch"
        href={altLangPath}
        aria-label={t(lang, 'langSwitchLabel')}
      >
        {t(lang, 'langSwitch')}
      </a>
    </nav>
  </div>
</header>
